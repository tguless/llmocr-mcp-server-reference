<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="00012-add-line-item-categorization" author="dev-team">
        <comment>Add categorization fields to invoice_line_items for billing audit workflow</comment>
        
        <!-- Add categorization columns -->
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="category_confidence" type="DECIMAL(5,4)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="categorized_by" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="requires_review" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="reviewed_by" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="reviewed_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <!-- Add energy-specific columns -->
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="energy_unit" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="energy_quantity" type="DECIMAL(15,3)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <addColumn tableName="invoice_line_items" schemaName="mcp_invoice">
            <column name="energy_rate" type="DECIMAL(10,6)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        
        <!-- Add indexes for category queries -->
        <createIndex tableName="invoice_line_items" schemaName="mcp_invoice" 
                     indexName="idx_line_items_category">
            <column name="category"/>
        </createIndex>
        
        <createIndex tableName="invoice_line_items" schemaName="mcp_invoice" 
                     indexName="idx_line_items_requires_review">
            <column name="requires_review"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

