<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="00036-create-json-schemas-table" author="llm-ocr">
        <comment>
            Create JSON schemas table for versioned schema management.
            Each tenant can define their own schemas for raw JSON validation.
        </comment>

        <createTable tableName="json_schemas" schemaName="mcp_invoice">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Tenant Context -->
            <column name="tenant_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <!-- Schema Metadata -->
            <column name="schema_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="schema_version" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>

            <!-- Schema Definition (JSON Schema format) -->
            <column name="schema_definition" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <!-- Status -->
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <!-- Timestamps -->
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <!-- Unique constraint: tenant + schema_name + version -->
        <addUniqueConstraint 
            tableName="json_schemas"
            schemaName="mcp_invoice"
            columnNames="tenant_id, schema_name, schema_version"
            constraintName="uk_json_schemas_tenant_name_version"
        />

        <!-- Indexes -->
        <createIndex indexName="idx_json_schemas_tenant_id" tableName="json_schemas" schemaName="mcp_invoice">
            <column name="tenant_id"/>
        </createIndex>

        <createIndex indexName="idx_json_schemas_name" tableName="json_schemas" schemaName="mcp_invoice">
            <column name="schema_name"/>
        </createIndex>

        <createIndex indexName="idx_json_schemas_active" tableName="json_schemas" schemaName="mcp_invoice">
            <column name="is_active"/>
        </createIndex>

        <createIndex indexName="idx_json_schemas_tenant_name" tableName="json_schemas" schemaName="mcp_invoice">
            <column name="tenant_id"/>
            <column name="schema_name"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

