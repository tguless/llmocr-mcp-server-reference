<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="00026-create-password-reset-tokens-table" author="llm-ocr">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="password_reset_tokens" schemaName="mcp_invoice"/>
            </not>
        </preConditions>

        <createTable tableName="password_reset_tokens" schemaName="mcp_invoice">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="expiry_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Foreign key constraint -->
        <addForeignKeyConstraint
                constraintName="fk_password_reset_tokens_user"
                baseTableName="password_reset_tokens"
                baseTableSchemaName="mcp_invoice"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedTableSchemaName="mcp_invoice"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- Index on token for faster lookups -->
        <createIndex indexName="idx_password_reset_tokens_token"
                     tableName="password_reset_tokens"
                     schemaName="mcp_invoice">
            <column name="token"/>
        </createIndex>

        <!-- Index on user_id for faster lookups -->
        <createIndex indexName="idx_password_reset_tokens_user_id"
                     tableName="password_reset_tokens"
                     schemaName="mcp_invoice">
            <column name="user_id"/>
        </createIndex>

        <!-- Index on expiry_date for cleanup operations -->
        <createIndex indexName="idx_password_reset_tokens_expiry"
                     tableName="password_reset_tokens"
                     schemaName="mcp_invoice">
            <column name="expiry_date"/>
        </createIndex>

        <rollback>
            <dropTable tableName="password_reset_tokens" schemaName="mcp_invoice"/>
        </rollback>
    </changeSet>
</databaseChangeLog>

